  propertyGstNumber              String?                         @db.VarChar(15)
  placeOfSupply                  String?
  bookingCode                    String
  guestName                      String?
  checkIn                        DateTime?
  checkOut                       DateTime?
  totalBookingValue              Decimal                         @db.Decimal(10, 2)
  description                    String                          @default("Platform Service Fee")
  sacCode                        String                          @default("9985")
  commissionPercent              Float
  commissionAmount               Decimal                         @db.Decimal(10, 2)
  cgstPercent                    Float?
  sgstPercent                    Float?
  igstPercent                    Float?
  cgstAmount                     Decimal?                        @db.Decimal(10, 2)
  sgstAmount                     Decimal?                        @db.Decimal(10, 2)
  igstAmount                     Decimal?                        @db.Decimal(10, 2)
  totalTaxOnCommission           Decimal                         @default(0.00) @db.Decimal(10, 2)
  tcsPercent                     Float?
  tcsAmount                      Decimal                         @default(0.00) @db.Decimal(10, 2)
  invoiceTotal                   Decimal                         @db.Decimal(10, 2)
  invoiceTotalInWords            String?                         @db.Text
  currency                       String                          @default("INR")
  status                         CommissionInvoice_status        @default(ISSUED)
  issuedAt                       DateTime                        @default(now())
  cancelledAt                    DateTime?
  settlementReferenceId          String?
  rawDataJson                    String?                         @db.LongText
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime
  Admin                          Admin                           @relation(fields: [adminId], references: [id])
  Booking                        Booking                         @relation(fields: [bookingId], references: [id])
  SuperAdmin                     SuperAdmin?                     @relation(fields: [createdBySuperAdminId], references: [id])
  AdminSettlementLedger          AdminSettlementLedger           @relation(fields: [ledgerId], references: [id])
  Property                       Property                        @relation(fields: [propertyId], references: [id])
  AdminSuperAdminTransfer        AdminSuperAdminTransfer?        @relation(fields: [transferId], references: [id])
  AdminSuperAdminTransferPayment AdminSuperAdminTransferPayment? @relation(fields: [transferPaymentId], references: [id])

  @@index([adminId, issuedAt])
  @@index([bookingId])
  @@index([createdBySuperAdminId])
  @@index([propertyId, issuedAt])
  @@index([status])
  @@index([transferId])
  @@index([transferPaymentId])
}

model PushSubscription {
  id             String                    @id
  userId         String
  userType       PushSubscription_userType
  endpoint       String                    @db.VarChar(1024)
  endpointHash   String                    @unique @db.VarChar(64)
  p256dh         String                    @db.Text
  auth           String                    @db.Text
  expirationTime DateTime?
  userAgent      String?                   @db.Text
  deviceLabel    String?
  isActive       Boolean                   @default(true)
  lastUsedAt     DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime

  @@index([isActive])
  @@index([userId, userType])
}

model SuperAdminDepartment {
  id                          String                        @id
  name                        String
  description                 String?                       @db.Text
  isActive                    Boolean                       @default(true)
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime
  deletedAt                   DateTime?
  deletedBySuperAdminId       String?
  isDeleted                   Boolean                       @default(false)
  SuperAdminDepartmentAccess  SuperAdminDepartmentAccess[]
  SuperAdminDepartmentSection SuperAdminDepartmentSection[]

  @@index([deletedBySuperAdminId])
  @@index([isActive])
  @@index([isDeleted])
  @@index([name, isDeleted])
}

model SuperAdminDepartmentAccess {
  id                                String                              @id
  superAdminId                      String
  departmentId                      String
  isActive                          Boolean                             @default(true)
  createdAt                         DateTime                            @default(now())
  updatedAt                         DateTime
  SuperAdminDepartment              SuperAdminDepartment                @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  SuperAdmin                        SuperAdmin                          @relation(fields: [superAdminId], references: [id], onDelete: Cascade)
  SuperAdminDepartmentAccessSection SuperAdminDepartmentAccessSection[]

  @@unique([superAdminId, departmentId])
  @@index([departmentId])
  @@index([isActive])
  @@index([superAdminId])
}

model SuperAdminDepartmentAccessSection {
  id                           String                     @id
  superAdminDepartmentAccessId String
  accessSectionId              String
  createdAt                    DateTime                   @default(now())
  AccessSection                AccessSection              @relation(fields: [accessSectionId], references: [id], onDelete: Cascade)
  SuperAdminDepartmentAccess   SuperAdminDepartmentAccess @relation(fields: [superAdminDepartmentAccessId], references: [id], onDelete: Cascade)

  @@unique([superAdminDepartmentAccessId, accessSectionId])
  @@index([accessSectionId])
  @@index([superAdminDepartmentAccessId])
}

model SuperAdminDepartmentSection {
  id                   String               @id
  departmentId         String
  accessSectionId      String
  createdAt            DateTime             @default(now())
  AccessSection        AccessSection        @relation(fields: [accessSectionId], references: [id], onDelete: Cascade)
  SuperAdminDepartment SuperAdminDepartment @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([departmentId, accessSectionId])
  @@index([accessSectionId])
  @@index([departmentId])
}

model SuperAdminSetupToken {
  id           String                    @id
  superAdminId String
  tokenHash    String                    @unique
  type         SuperAdminSetupToken_type @default(ACCOUNT_SETUP)
  isUsed       Boolean                   @default(false)
  isActive     Boolean                   @default(true)
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime
  SuperAdmin   SuperAdmin                @relation(fields: [superAdminId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([isActive])
  @@index([superAdminId])
}

